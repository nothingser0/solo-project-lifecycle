# Ruby on Rails Environment Variables
# Copy this file to .env and fill in actual values
# DO NOT commit .env to version control

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/myapp_development
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/myapp_test

# Rails
SECRET_KEY_BASE=your_secret_key_here_generate_with_rails_secret
RAILS_ENV=development
RAILS_MAX_THREADS=5

# Redis (for ActionCable, Sidekiq, caching)
REDIS_URL=redis://localhost:6379/0

# External Services
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

# Email (SMTP)
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_DOMAIN=example.com

# Payment Gateway (if applicable)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Application Settings
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=changeme
MAX_LOGIN_ATTEMPTS=5
SESSION_TIMEOUT_HOURS=24

# Frontend URL (if separate)
FRONTEND_URL=http://localhost:3000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
