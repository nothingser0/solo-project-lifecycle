{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://solo-project-lifecycle.com/schemas/prd.json",
  "title": "Product Requirements Document",
  "description": "Schema for validating PRD.md filled templates",
  "type": "object",
  "required": [
    "projectName",
    "version",
    "author",
    "date",
    "objectives",
    "userStories",
    "functionalRequirements",
    "nonFunctionalRequirements",
    "acceptanceCriteria"
  ],
  "properties": {
    "projectName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "description": "Name of the project"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)"
    },
    "author": {
      "type": "string",
      "minLength": 2,
      "description": "Document author name"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Document creation date (YYYY-MM-DD)"
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["metric", "target", "rationale"],
        "properties": {
          "metric": {
            "type": "string",
            "description": "Measurable metric (e.g., 'Conversion rate')"
          },
          "target": {
            "type": "string",
            "description": "Target value (e.g., '3% increase')"
          },
          "rationale": {
            "type": "string",
            "description": "Why this metric matters"
          }
        }
      }
    },
    "userStories": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "role", "goal", "benefit", "priority"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^US-\\d+$",
            "description": "User story ID (e.g., US-001)"
          },
          "role": {
            "type": "string",
            "description": "User role (e.g., 'customer', 'admin')"
          },
          "goal": {
            "type": "string",
            "description": "What user wants to do"
          },
          "benefit": {
            "type": "string",
            "description": "Why user wants this"
          },
          "priority": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low"],
            "description": "Story priority"
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "functionalRequirements": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "feature", "description", "priority"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FR-\\d+$",
            "description": "Functional requirement ID"
          },
          "feature": {
            "type": "string",
            "description": "Feature name"
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "description": "Detailed feature description"
          },
          "priority": {
            "type": "string",
            "enum": ["Must-Have", "Should-Have", "Could-Have", "Won't-Have"]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^FR-\\d+$"
            }
          }
        }
      }
    },
    "nonFunctionalRequirements": {
      "type": "object",
      "required": ["performance", "security", "usability"],
      "properties": {
        "performance": {
          "type": "object",
          "properties": {
            "pageLoadTime": {
              "type": "string",
              "pattern": "^<\\d+(\\.\\d+)?s$",
              "description": "Max page load time (e.g., <2s)"
            },
            "apiResponseTime": {
              "type": "string",
              "pattern": "^<\\d+ms$",
              "description": "Max API response time"
            }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "authentication": {
              "type": "string",
              "description": "Auth method (e.g., JWT, OAuth)"
            },
            "dataEncryption": {
              "type": "boolean",
              "description": "Encrypt sensitive data at rest"
            },
            "httpsOnly": {
              "type": "boolean",
              "description": "Enforce HTTPS"
            }
          }
        },
        "usability": {
          "type": "object",
          "properties": {
            "accessibility": {
              "type": "string",
              "enum": ["WCAG 2.1 AA", "WCAG 2.1 AAA"],
              "description": "Accessibility standard"
            },
            "mobileResponsive": {
              "type": "boolean",
              "description": "Mobile-friendly design"
            }
          }
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "description": "Testable acceptance criterion"
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Explicitly excluded features"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "impact", "mitigation"],
        "properties": {
          "description": {
            "type": "string"
          },
          "impact": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    }
  }
}
