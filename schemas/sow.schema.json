{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://solo-project-lifecycle.com/schemas/sow.json",
  "title": "Statement of Work Contract",
  "description": "Schema for validating SOW_CONTRACT.md filled templates",
  "type": "object",
  "required": [
    "contractNumber",
    "date",
    "client",
    "developer",
    "projectScope",
    "deliverables",
    "timeline",
    "budget",
    "paymentTerms",
    "ipOwnership"
  ],
  "properties": {
    "contractNumber": {
      "type": "string",
      "pattern": "^SOW-\\d{4}-\\d{3}$",
      "description": "Contract ID (e.g., SOW-2026-001)"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "client": {
      "type": "object",
      "required": ["name", "address", "contact"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3
        },
        "legalEntity": {
          "type": "string",
          "description": "PT, CV, or Individual"
        },
        "address": {
          "type": "string"
        },
        "contact": {
          "type": "object",
          "required": ["name", "phone", "email"],
          "properties": {
            "name": {
              "type": "string"
            },
            "phone": {
              "type": "string",
              "pattern": "^(\\+62|08)\\d{8,12}$"
            },
            "email": {
              "type": "string",
              "format": "email"
            }
          }
        }
      }
    },
    "developer": {
      "type": "object",
      "required": ["name", "contact"],
      "properties": {
        "name": {
          "type": "string"
        },
        "legalEntity": {
          "type": "string"
        },
        "contact": {
          "type": "object",
          "required": ["phone", "email"],
          "properties": {
            "phone": {
              "type": "string",
              "pattern": "^(\\+62|08)\\d{8,12}$"
            },
            "email": {
              "type": "string",
              "format": "email"
            }
          }
        }
      }
    },
    "projectScope": {
      "type": "object",
      "required": ["mustHave", "outOfScope"],
      "properties": {
        "mustHave": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          },
          "description": "Must-Have features"
        },
        "shouldHave": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outOfScope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Explicitly excluded features"
        }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "description": "File format (e.g., GitHub repo, PDF, Figma)"
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "required": ["startDate", "endDate", "milestones"],
      "properties": {
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "milestones": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["name", "dueDate", "deliverables"],
            "properties": {
              "name": {
                "type": "string"
              },
              "dueDate": {
                "type": "string",
                "format": "date"
              },
              "deliverables": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["total", "currency", "breakdown"],
      "properties": {
        "total": {
          "type": "number",
          "minimum": 1000000,
          "description": "Total project cost in Rupiah"
        },
        "currency": {
          "type": "string",
          "enum": ["IDR", "USD"],
          "default": "IDR"
        },
        "breakdown": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "amount"],
            "properties": {
              "item": {
                "type": "string"
              },
              "amount": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "paymentTerms": {
      "type": "object",
      "required": ["schedule"],
      "properties": {
        "schedule": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["milestone", "percentage", "amount", "trigger"],
            "properties": {
              "milestone": {
                "type": "string",
                "description": "Payment milestone name"
              },
              "percentage": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "amount": {
                "type": "number"
              },
              "trigger": {
                "type": "string",
                "description": "Payment trigger event"
              },
              "dueDate": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        "method": {
          "type": "string",
          "description": "Payment method (e.g., bank transfer)"
        }
      }
    },
    "ipOwnership": {
      "type": "object",
      "required": ["transferTiming"],
      "properties": {
        "transferTiming": {
          "type": "string",
          "enum": [
            "Upon final payment",
            "Upon delivery",
            "Retained by developer"
          ]
        },
        "licenseType": {
          "type": "string",
          "description": "If not transferred, license type"
        }
      }
    },
    "warranty": {
      "type": "object",
      "properties": {
        "period": {
          "type": "number",
          "description": "Warranty period in days"
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What's covered (e.g., bug fixes)"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "changeRequestPolicy": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "pricing": {
          "type": "string",
          "description": "How change requests are priced"
        }
      }
    },
    "terminationClause": {
      "type": "object",
      "properties": {
        "noticePeriod": {
          "type": "number",
          "description": "Notice period in days"
        },
        "refundPolicy": {
          "type": "string"
        }
      }
    },
    "governingLaw": {
      "type": "string",
      "default": "Indonesia",
      "description": "Governing law jurisdiction"
    }
  }
}
