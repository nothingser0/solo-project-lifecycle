{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://solo-project-lifecycle.dev/schemas/todo.schema.json",
  "title": "TODO.md (M06 Development Checklist)",
  "description": "AI-generated development checklist with 100% FSD coverage",
  "type": "object",
  "required": [
    "projectName",
    "generatedDate",
    "techStack",
    "phases",
    "completionStats"
  ],
  "properties": {
    "projectName": {
      "type": "string",
      "description": "Project name from SCOPE_STATEMENT.md"
    },
    "generatedDate": {
      "type": "string",
      "format": "date",
      "description": "Date TODO.md was generated"
    },
    "techStack": {
      "type": "object",
      "description": "Technology stack from FSD.md",
      "required": ["frontend", "backend", "database"],
      "properties": {
        "frontend": { "type": "string" },
        "backend": { "type": "string" },
        "database": { "type": "string" },
        "infrastructure": { "type": "string" },
        "thirdParty": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "phases": {
      "type": "array",
      "description": "Development phases (Backend, Frontend, Integration, Polish)",
      "items": {
        "type": "object",
        "required": ["phase", "tasks"],
        "properties": {
          "phase": {
            "type": "string",
            "enum": ["Backend", "Frontend", "Integration", "Polish", "Custom"]
          },
          "description": { "type": "string" },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "task", "status"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Z0-9]+-[0-9]+$" },
                "task": { "type": "string", "minLength": 10 },
                "status": {
                  "type": "string",
                  "enum": ["TODO", "IN_PROGRESS", "DONE", "BLOCKED", "SKIPPED"]
                },
                "priority": {
                  "type": "string",
                  "enum": ["P0", "P1", "P2", "P3"]
                },
                "estimate": {
                  "type": "string",
                  "description": "Time estimate (e.g., '2h', '1d')"
                },
                "dependencies": {
                  "type": "array",
                  "description": "Task IDs this depends on",
                  "items": { "type": "string" }
                },
                "fsdReference": {
                  "type": "string",
                  "description": "Reference to FSD.md section"
                },
                "assignedTo": { "type": "string" },
                "notes": { "type": "string" },
                "completedDate": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "completionStats": {
      "type": "object",
      "description": "Overall completion statistics",
      "required": ["total", "completed", "percentage"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "completed": { "type": "integer", "minimum": 0 },
        "inProgress": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "milestones": {
      "type": "array",
      "description": "Payment/delivery milestones",
      "items": {
        "type": "object",
        "required": ["milestone", "criteria", "targetDate"],
        "properties": {
          "milestone": {
            "type": "string",
            "enum": ["Alpha", "Beta", "RC", "Production"]
          },
          "criteria": {
            "type": "array",
            "items": { "type": "string" }
          },
          "targetDate": { "type": "string", "format": "date" },
          "completed": { "type": "boolean" },
          "completedDate": { "type": "string", "format": "date" }
        }
      }
    },
    "blockers": {
      "type": "array",
      "description": "Current blockers preventing progress",
      "items": {
        "type": "object",
        "required": ["taskId", "blocker", "severity"],
        "properties": {
          "taskId": { "type": "string" },
          "blocker": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["Low", "Medium", "High", "Critical"]
          },
          "owner": { "type": "string" },
          "resolution": { "type": "string" }
        }
      }
    }
  }
}
