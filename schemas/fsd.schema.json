{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://solo-project-lifecycle.com/schemas/fsd.json",
  "title": "Functional Specification Document",
  "description": "Schema for validating FSD.md filled templates",
  "type": "object",
  "required": [
    "projectName",
    "version",
    "author",
    "date",
    "techStack",
    "databaseSchema",
    "apiEndpoints",
    "security"
  ],
  "properties": {
    "projectName": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "author": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "techStack": {
      "type": "object",
      "required": ["frontend", "backend", "database"],
      "properties": {
        "frontend": {
          "type": "object",
          "required": ["framework"],
          "properties": {
            "framework": {
              "type": "string",
              "description": "Frontend framework (e.g., Next.js 15, React 19)"
            },
            "language": {
              "type": "string",
              "description": "Programming language (e.g., TypeScript)"
            },
            "uiLibrary": {
              "type": "string",
              "description": "UI component library (e.g., shadcn/ui)"
            }
          }
        },
        "backend": {
          "type": "object",
          "required": ["framework"],
          "properties": {
            "framework": {
              "type": "string",
              "description": "Backend framework (e.g., Next.js API, Laravel 11)"
            },
            "language": {
              "type": "string"
            },
            "orm": {
              "type": "string",
              "description": "ORM/Query builder (e.g., Prisma, Eloquent)"
            }
          }
        },
        "database": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["PostgreSQL", "MySQL", "MongoDB", "SQLite"]
            },
            "version": {
              "type": "string"
            }
          }
        },
        "hosting": {
          "type": "object",
          "properties": {
            "platform": {
              "type": "string",
              "description": "Hosting platform (e.g., Vercel, AWS, VPS)"
            },
            "region": {
              "type": "string"
            }
          }
        }
      }
    },
    "databaseSchema": {
      "type": "object",
      "required": ["tables"],
      "properties": {
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "columns"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z_]+$",
                "description": "Table name (snake_case)"
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["name", "type"],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "description": "Data type (e.g., VARCHAR(255), INT, TEXT)"
                    },
                    "nullable": {
                      "type": "boolean",
                      "default": false
                    },
                    "unique": {
                      "type": "boolean",
                      "default": false
                    },
                    "primaryKey": {
                      "type": "boolean",
                      "default": false
                    }
                  }
                }
              },
              "indexes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "columns": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "unique": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "apiEndpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method", "path", "description"],
        "properties": {
          "method": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
          },
          "path": {
            "type": "string",
            "pattern": "^/api/",
            "description": "API endpoint path"
          },
          "description": {
            "type": "string"
          },
          "authentication": {
            "type": "boolean",
            "description": "Requires authentication"
          },
          "requestBody": {
            "type": "object",
            "description": "Request body schema"
          },
          "responseBody": {
            "type": "object",
            "description": "Response body schema"
          },
          "errorCodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "required": ["authentication", "dataProtection"],
      "properties": {
        "authentication": {
          "type": "object",
          "required": ["method"],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["JWT", "OAuth 2.0", "Session", "API Key"]
            },
            "tokenExpiry": {
              "type": "string",
              "description": "Token expiry time (e.g., 15m, 7d)"
            }
          }
        },
        "dataProtection": {
          "type": "object",
          "properties": {
            "passwordHashing": {
              "type": "string",
              "enum": ["bcrypt", "argon2id"],
              "description": "Password hashing algorithm"
            },
            "dataEncryption": {
              "type": "string",
              "enum": ["AES-256-GCM", "AES-256-CBC"],
              "description": "At-rest encryption algorithm"
            },
            "httpsOnly": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "rateLimiting": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxRequests": {
              "type": "integer",
              "description": "Max requests per window"
            },
            "windowMs": {
              "type": "integer",
              "description": "Window duration in milliseconds"
            }
          }
        }
      }
    },
    "thirdPartyIntegrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "purpose"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Service name (e.g., Midtrans, AWS S3)"
          },
          "purpose": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string"
          },
          "authentication": {
            "type": "string",
            "description": "Auth method (e.g., API key, OAuth)"
          }
        }
      }
    }
  }
}
